{
  "name": "traverse",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "deploy": "vercel --prod",
    "lint": "eslint",
    "load-test": "node load-tests/api-load-test.js",
    "load-test:single": "node load-tests/api-load-test.js --url http://localhost:3000/api/ai/recommend --duration 60 --concurrency 100",
    "load-test:chat": "node load-tests/api-load-test.js --url http://localhost:3000/api/ai/chat --duration 60 --concurrency 100",
    "load-test:otp": "node load-tests/api-load-test.js --url http://localhost:3000/api/auth/send-otp --duration 15 --concurrency 100",
    "load-test:destinations": "node load-tests/api-load-test.js --url http://localhost:3000/destinations --duration 60 --concurrency 100"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.1",
    "appium": "^3.6.0",
    "exceljs": "^4.4.0",
    "framer-motion": "^12.40.0",
    "gsap": "^3.15.0",
    "html2pdf.js": "^0.14.0",
    "lucide-react": "^1.18.0",
    "next": "15.5.18",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.5",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "selenium-webdriver": "^4.47.0",
    "three": "^0.184.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.184.1",
    "eslint": "^9",
    "eslint-config-next": "15.5.18",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
